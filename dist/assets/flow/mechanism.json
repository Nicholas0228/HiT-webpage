      "w": 100,
      "h": 62,
      "label": [
        "Features",
        "H: [N, d]"
      ],
      "size": 18,
      "kind": "tensor",
      "shape": "[N, d]",
      "info": "Contextual token features enter the router.",
      "params": "H comes from the encoder.",
      "tags": [
        "affinity"
      ]
    },
    {
      "id": "projections",
      "x": 154,
      "y": 52,
      "w": 140,
      "h": 62,
      "label": [
        "Normalize",
        "qᵢ and kᵢ"
      ],
      "size": 18,
      "kind": "train",
      "shape": "[N, d] → two [N, dᵣ] arrays",
      "info": "Learned projections are normalized to unit length.",
      "params": "qᵢ = Wq hᵢ / ‖Wq hᵢ‖₂; kᵢ = Wk hᵢ / ‖Wk hᵢ‖₂",
      "tags": [
        "affinity"
      ]
    },
    {
      "id": "affinity",
      "x": 324,
      "y": 52,
      "w": 140,
      "h": 62,
      "label": [
        "Symmetric",
        "affinity S"
      ],
      "size": 18,
      "kind": "side",
      "shape": "[N, N]",
      "info": "Compare each pair of tokens in both directions and average the results.",
      "params": "Sᵢⱼ = (qᵢᵀ kⱼ + qⱼᵀ kᵢ) / 2",
      "tags": [
        "affinity"
      ]
    },
    {
      "id": "linkage",
      "x": 494,
      "y": 52,
      "w": 150,
      "h": 62,
      "label": [
        "Average",
        "linkage"
      ],
      "size": 18,
      "kind": "plain",
      "shape": "[N, N] → K hard groups",
      "info": "Merge the pair of groups with the largest average cross-group affinity. Cut the hierarchy at τ.",
      "params": "s(U,V) = Σᵢ∈U Σⱼ∈V Sᵢⱼ / (|U| |V|)",
      "tags": [
        "affinity"
      ]
    },
    {
      "id": "scores",
      "x": 674,
      "y": 52,
      "w": 180,
      "h": 62,
      "label": [
        "Group mean",
        "eᵢg"
      ],
      "size": 18,
      "kind": "side",
      "shape": "[N, K]",
      "info": "Average each token’s affinities to all members of a hard group.",
      "params": "eᵢg = Σⱼ∈Gg Sᵢⱼ / |Gg|",
      "tags": [
        "affinity",
        "pooling"
      ]
    },
    {
      "id": "weights",
      "x": 884,
      "y": 52,
      "w": 248,
      "h": 62,
      "label": [
        "Soft weights",
        "A: [N, K]"
      ],
      "size": 18,
      "kind": "side",
      "shape": "[N, K]",
      "info": "Apply a softmax over groups for each token. Each row sums to one.",
      "params": "Aᵢg = softmax_g(eᵢg / Tᵣ)",
      "tags": [
        "pooling",
        "readback"
      ]
    },
    {
      "id": "affinity-equation",
      "type": "text",
      "x": 394,
      "y": 150,
      "label": [
        "Sᵢⱼ = ½(qᵢᵀkⱼ + qⱼᵀkᵢ)"
      ],
      "size": 18,
      "anchor": "middle"
    },
    {
      "id": "threshold",
      "type": "text",
      "x": 569,
      "y": 180,
      "label": [
        "Cut at τ"
      ],
      "size": 18,
      "anchor": "middle"
    },
    {
      "id": "weights-equation",
      "type": "text",
      "x": 903,
      "y": 150,
      "label": [
        "Aᵢg = exp(eᵢg / Tᵣ) / Σₕ exp(eᵢh / Tᵣ)"
      ],
      "size": 18,
      "anchor": "middle"
    },
    {
      "id": "pool",
      "x": 54,
      "y": 248,
      "w": 190,
      "h": 64,
      "label": [
        "Soft pooling",
        "N → K"
      ],
      "size": 18,
      "kind": "side",
      "shape": "H [N, d] and A [N, K] → Z [K, d]",
      "info": "Normalize each column of A. Use the resulting weights to take a feature average over all input tokens.",
      "params": "Zg = Σᵢ Aᵢg hᵢ / Σᵢ Aᵢg",
      "tags": [
        "pooling"
      ]
    },
    {
      "id": "pooled",
      "x": 280,
      "y": 248,
      "w": 140,
      "h": 64,
      "label": [
        "Group features",
        "Z: [K, d]"
      ],
      "size": 18,
      "kind": "tensor",
      "shape": "[K, d]",
      "info": "Each group feature is a weighted mean. Tokens outside its hard group can also contribute.",
      "params": "The hard group defines the affinity prototype.",
      "tags": [
        "pooling"
      ]
    },
    {
      "id": "process",
      "x": 458,
      "y": 248,
      "w": 174,
      "h": 64,
      "label": [
        "Compact network",
        "M"
      ],
      "size": 18,
      "kind": "train",
      "shape": "[K, d] → [K, d]",
      "info": "Process the compact group features. The network can contain another grouping stage.",
      "params": "Z′ = M(Z)",
      "tags": [
        "compact"
      ]
    },
    {
      "id": "readback",
      "x": 670,
      "y": 248,
      "w": 184,
      "h": 64,
      "label": [
        "Soft readback",
        "K → N"
      ],
      "size": 18,
      "kind": "side",
      "shape": "A [N, K] × Z′ [K, d] → R [N, d]",
      "info": "Use the same A to distribute processed group features to each input position.",
      "params": "Rᵢ = Σg Aᵢg Z′g",
      "tags": [
        "readback"
      ]
    },
    {
      "id": "restored",
      "x": 892,
      "y": 248,
      "w": 240,
      "h": 64,
      "label": [
        "Restored features",
        "R: [N, d]"
      ],
      "size": 18,
      "kind": "tensor",
      "shape": "[N, d]",
      "info": "Add the learned skip, then pass the result to the decoder.",
      "params": "D(R + Skip(H))",
      "tags": [
        "readback"
      ]
    },
    {
      "id": "pool-formula",
      "type": "text",
      "x": 238,
      "y": 352,
      "label": [
        "Zg = Σᵢ Aᵢg hᵢ / Σᵢ Aᵢg"
      ],
      "size": 18,
      "anchor": "middle"
    },
    {
      "id": "pool-normalization",
      "type": "text",
      "x": 238,
      "y": 380,
      "label": [
        "Columns are normalized for pooling."
      ],
      "size": 18,
      "anchor": "middle"
    },
    {
      "id": "readback-formula",
      "type": "text",
      "x": 890,
      "y": 352,
      "label": [
        "Rᵢ = Σg Aᵢg Z′g"
      ],
      "size": 18,
      "anchor": "middle"
    },
    {
      "id": "readback-normalization",
      "type": "text",
      "x": 890,
      "y": 380,
      "label": [
        "Each row of A sums to one."
      ],
      "size": 18,
      "anchor": "middle"
    },
